    {
        "name": "test_creating_entry_removes_entries_for_same_host_or_bridge",
        "device_type": "Hue Bridge",
        "states": {
            "initial_state": {
                "variables": {}
            },
            "state_entries_added": {
                "variables": {
                    "len(hass.config_entries.async_entries('hue'))": "2"
                }
            },
            "state_flow_form": {
                "variables": {
                    "result['type']": "FlowResultType.FORM",
                    "result['step_id']": "'link'"
                }
            },
            "state_entry_created": {
                "variables": {
                    "result['type']": "FlowResultType.CREATE_ENTRY",
                    "result['title']": "'Hue Bridge id-1234'",
                    "result['data']": "{'host': '2.2.2.2', 'api_key': '123456789', 'api_version': 1}"
                }
            },
            "state_entries_checked": {
                "variables": {
                    "len(entries)": "2"
                }
            },
            "state_entry_verified": {
                "variables": {
                    "orig_entry.entry_id": "new_entry.entry_id",
                    "new_entry.unique_id": "'id-1234'"
                }
            }
        },
        "transitions": [
            {
                "action": "setup_existing_entries",
                "starting_state": "initial_state",
                "ending_state": "state_entries_added",
                "inputs": {
                    "create_mock_api_discovery": "create_mock_api_discovery(aioclient_mock, [('2.2.2.2', 'id-1234')])",
                    "orig_entry_creation": "orig_entry = MockConfigEntry(domain=DOMAIN, data={'host': '0.0.0.0', 'api_key': '123456789'}, unique_id='id-1234')",
                    "orig_entry_add": "orig_entry.add_to_hass(hass)",
                    "second_entry_add": "MockConfigEntry(domain=DOMAIN, data={'host': '1.2.3.4', 'api_key': '123456789'}, unique_id='id-5678').add_to_hass(hass)"
                }
            },
            {
                "action": "async_init_flow",
                "starting_state": "state_entries_added",
                "ending_state": "state_flow_form",
                "inputs": {
                    "async_init_call": "result = await hass.config_entries.flow.async_init(DOMAIN, data={'host': '2.2.2.2'}, context={'source': config_entries.SOURCE_IMPORT})"
                }
            },
            {
                "action": "async_configure_flow",
                "starting_state": "state_flow_form",
                "ending_state": "state_entry_created",
                "inputs": {
                    "patches_and_configure": "with patch('homeassistant.components.hue.config_flow.create_app_key', return_value='123456789'), patch('homeassistant.components.hue.async_unload_entry', return_value=True):\n    result = await hass.config_entries.flow.async_configure(result['flow_id'], {})"
                }
            },
            {
                "action": "retrieve_entries",
                "starting_state": "state_entry_created",
                "ending_state": "state_entries_checked",
                "inputs": {
                    "get_entries": "entries = hass.config_entries.async_entries('hue')"
                }
            },
            {
                "action": "verify_new_entry",
                "starting_state": "state_entries_checked",
                "ending_state": "state_entry_verified",
                "inputs": {
                    "select_new_entry": "new_entry = entries[-1]"
                }
            }
        ]
    },
