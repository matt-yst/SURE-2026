                "action": "emit_event",
                "starting_state": "state1",
                "ending_state": "state2",
                "inputs": {
                    "event": "update",
                    "payload": "updated_sensor (motion True)"
                }
            },
            {
                "action": "emit_event",
                "starting_state": "state2",
                "ending_state": "state3",
                "inputs": {
                    "event": "update",
                    "payload": "updated_sensor (motion False, motion_report.changed True)"
                }
            },
            {
                "action": "emit_event",
                "starting_state": "state3",
                "ending_state": "state4",
                "inputs": {
                    "event": "update",
                    "payload": "updated_sensor (motion True, motion_report.changed False)"
                }
            }
        ]
