            },
            "state3": {
                "variables": {
                    "hass.states.get(test_entity_id).state": "'on'"
                }
            },
            "state4": {
                "variables": {
                    "hass.states.get(test_entity_id).state": "'off'"
                }
            }
        },
        "transitions": [
            {
                "action": "emit_event",
                "starting_state": "state0",
                "ending_state": "state1",
                "inputs": {
                    "event": "add",
                    "payload": "FAKE_BINARY_SENSOR"
