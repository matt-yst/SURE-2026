    {
        "name": "test_sensors",
        "device_type": "sensor",
        "states": {
            "initial_state": {
                "variables": {}
            },
            "setup_state": {
                "variables": {
                    "len(mock_bridge_v1.mock_requests)": "1",
                    "len(hass.states.async_all())": "7"
                }
            },
            "living_room_state": {
                "variables": {
                    "presence_sensor_1": "None",
                    "presence_sensor_1.state": "'on'",
                    "light_level_sensor_1": "None",
                    "light_level_sensor_1.state": "'1.0'",
                    "light_level_sensor_1.name": "'Living room sensor Light level'",
                    "temperature_sensor_1": "None",
                    "temperature_sensor_1.state": "'17.75'",
                    "temperature_sensor_1.name": "'Living room sensor Temperature'"
                }
            },
            "kitchen_state": {
                "variables": {
                    "presence_sensor_2": "None",
                    "presence_sensor_2.state": "'off'",
                    "light_level_sensor_2": "None",
                    "light_level_sensor_2.state": "'10.0'",
                    "light_level_sensor_2.name": "'Kitchen sensor Light level'",
                    "temperature_sensor_2": "None",
                    "temperature_sensor_2.state": "'18.75'",
                    "temperature_sensor_2.name": "'Kitchen sensor Temperature'"
                }
            },
            "battery_state": {
                "variables": {
                    "battery_remote_1": "None",
                    "battery_remote_1.state": "'100'",
                    "battery_remote_1.name": "'Hue dimmer switch 1 Battery level'",
                    "entity_registry.async_get('sensor.hue_dimmer_switch_1_battery_level').entity_category": "EntityCategory.DIAGNOSTIC"
                }
            }
        },
        "transitions": [
            {
                "action": "mock_bridge_v1.mock_sensor_responses.append(SENSOR_RESPONSE) & await setup_platform(hass, mock_bridge_v1, [Platform.BINARY_SENSOR, Platform.SENSOR])",
                "starting_state": "initial_state",
                "ending_state": "setup_state",
                "inputs": {
                    "mock_bridge_v1.mock_sensor_responses.append": "SENSOR_RESPONSE",
                    "setup_platform": {
                        "hass": "hass",
                        "mock_bridge_v1": "mock_bridge_v1",
                        "platforms": [
                            "Platform.BINARY_SENSOR",
                            "Platform.SENSOR"
                        ]
                    }
                }
            },
            {
                "action": "Retrieve living\u2011room sensors",
                "starting_state": "setup_state",
                "ending_state": "living_room_state",
                "inputs": {
                    "presence_sensor_1": "hass.states.get('binary_sensor.living_room_sensor_motion')",
                    "light_level_sensor_1": "hass.states.get('sensor.living_room_sensor_light_level')",
                    "temperature_sensor_1": "hass.states.get('sensor.living_room_sensor_temperature')"
                }
            },
            {
                "action": "Retrieve kitchen sensors",
                "starting_state": "living_room_state",
                "ending_state": "kitchen_state",
                "inputs": {
                    "presence_sensor_2": "hass.states.get('binary_sensor.kitchen_sensor_motion')",
                    "light_level_sensor_2": "hass.states.get('sensor.kitchen_sensor_light_level')",
                    "temperature_sensor_2": "hass.states.get('sensor.kitchen_sensor_temperature')"
                }
            },
            {
                "action": "Retrieve battery level of Hue dimmer switch",
                "starting_state": "kitchen_state",
                "ending_state": "battery_state",
                "inputs": {
                    "battery_remote_1": "hass.states.get('sensor.hue_dimmer_switch_1_battery_level')"
                }
            }
        ]
    },
