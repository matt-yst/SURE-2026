    {
        "name": "test_sensor_removed",
        "device_type": "sensor",
        "states": {
            "initial_state": {
                "variables": {}
            },
            "post_setup": {
                "variables": {
                    "len(mock_bridge_v1.mock_requests)": "1",
                    "len(hass.states.async_all())": "7"
                }
            },
            "post_refresh": {
                "variables": {
                    "len(mock_bridge_v1.mock_requests)": "2",
                    "len(hass.states.async_all())": "3"
                }
            },
            "sensor_check": {
                "variables": {
                    "sensor": "None"
                }
            },
            "removed_sensor_check": {
                "variables": {
                    "removed_sensor": "None"
                }
            }
        },
        "transitions": [
            {
                "action": "mock_bridge_v1.mock_sensor_responses.append",
                "starting_state": "initial_state",
                "ending_state": "initial_state",
                "inputs": {
                    "item": "SENSOR_RESPONSE"
                }
            },
            {
                "action": "setup_platform",
                "starting_state": "initial_state",
                "ending_state": "post_setup",
                "inputs": {
                    "hass": "hass",
                    "bridge": "mock_bridge_v1",
                    "platforms": [
                        "Platform.BINARY_SENSOR",
                        "Platform.SENSOR"
                    ]
                }
            },
            {
                "action": "refresh_and_update",
                "starting_state": "post_setup",
                "ending_state": "post_refresh",
                "inputs": {
                    "steps": [
                        "mock_bridge_v1.mock_sensor_responses.clear()",
                        "keys = ('1', '2', '3')",
                        "mock_bridge_v1.mock_sensor_responses.append({k: SENSOR_RESPONSE[k] for k in keys})",
                        "await mock_bridge_v1.sensor_manager.coordinator.async_refresh()",
                        "await hass.async_block_till_done()"
                    ]
                }
            },
            {
                "action": "hass.states.get",
                "starting_state": "post_refresh",
                "ending_state": "sensor_check",
                "inputs": {
                    "entity_id": "binary_sensor.living_room_sensor_motion"
                }
            },
            {
                "action": "hass.states.get",
                "starting_state": "sensor_check",
                "ending_state": "removed_sensor_check",
                "inputs": {
                    "entity_id": "binary_sensor.kitchen_sensor_motion"
                }
            }
        ]
    },
