    {
        "name": "test_rpc_rgbw_device_light_mode_remove_others",
        "device_type": "Shelly RPC RGBW (light mode)",
        "states": {
            "pre_setup_snapshot": {
                "variables": {
                    "get_entity(hass, LIGHT_DOMAIN, 'rgb:0')": "None",
                    "get_entity(hass, LIGHT_DOMAIN, 'rgbw:0')": "None"
                }
            },
            "post_setup_snapshot": {
                "variables": {
                    "get_entity(hass, LIGHT_DOMAIN, 'rgb:0')": "None",
                    "get_entity(hass, LIGHT_DOMAIN, 'rgbw:0')": "None"
                }
            }
        },
        "transitions": [
            {
                "action": "initialize_and_register_entities",
                "starting_state": "initial_state",
                "ending_state": "pre_setup_snapshot",
                "inputs": {
                    "monkeypatch_operations": [
                        "delitem(mock_rpc_device.status, 'rgb:0')",
                        "delitem(mock_rpc_device.status, 'rgbw:0')"
                    ],
                    "integration_initialisation": "config_entry = await init_integration(hass, 2, skip_setup=True)",
                    "device_registration": "device_entry = register_device(device_registry, config_entry)",
                    "entity_registrations": [
                        "register_entity(hass, LIGHT_DOMAIN, 'test_rgb_0', 'rgb:0', config_entry, device_id=device_entry.id)",
                        "register_entity(hass, LIGHT_DOMAIN, 'test_rgbw_0', 'rgbw:0', config_entry, device_id=device_entry.id)"
                    ]
                }
            },
            {
                "action": "setup_and_verify_entities",
                "starting_state": "pre_setup_snapshot",
                "ending_state": "post_setup_snapshot",
                "inputs": {
                    "config_entry_setup": "await hass.config_entries.async_setup(config_entry.entry_id)",
                    "await_block": "await hass.async_block_till_done()",
                    "entity_state_assertions": [
                        "for i in range(SHELLY_PLUS_RGBW_CHANNELS):",
                        "    entity_id = f'light.test_light_{i}'",
                        "    assert (state := hass.states.get(entity_id))",
                        "    assert state.state == STATE_ON",
                        "    assert (entry := entity_registry.async_get(entity_id))",
                        "    assert entry.unique_id == f'123456789ABC-light:{i}'"
                    ]
                }
            }
        ]
    },
    {
        "name": "test_rpc_rgbw_device_rgb_w_modes_remove_others",
        "device_type": "rgbw",
        "states": {
            "initial_state": {
                "variables": {}
            },
            "state_1": {
                "variables": {
                    "get_entity(hass, LIGHT_DOMAIN, removed_key)": "None"
                }
            },
            "state_2": {
                "variables": {
                    "state.state": "STATE_ON",
                    "entry.unique_id": "f'123456789ABC-{active_mode}:0'"
                }
            },
            "state_3": {
                "variables": {
                    "get_entity(hass, LIGHT_DOMAIN, removed_key)": "None"
                }
            }
        },
        "transitions": [
            {
                "action": "setup_and_register_entities",
                "starting_state": "initial_state",
                "ending_state": "state_1",
                "inputs": {
                    "config_entry": "await init_integration(hass, 2, skip_setup=True)",
                    "device_entry": "register_device(device_registry, config_entry)",
                    "remove_mode_status": "monkeypatch.delitem(mock_rpc_device.status, f'{removed_mode}:0')",
                    "register_removed_entity": "register_entity(hass, LIGHT_DOMAIN, f'test_{removed_key}', removed_key, config_entry, device_id=device_entry.id)",
                    "assert_initial_entities": "for i in range(SHELLY_PLUS_RGBW_CHANNELS): assert get_entity(hass, LIGHT_DOMAIN, f'light:{i}') is not None"
                }
            },
            {
                "action": "setup_config_entry_and_activate_mode",
                "starting_state": "state_1",
                "ending_state": "state_2",
                "inputs": {
                    "setup_entry": "await hass.config_entries.async_setup(config_entry.entry_id)",
                    "block_till_done": "await hass.async_block_till_done()",
                    "activate_mode_entity": "entity_id = f'light.test_name_test_{active_mode}_0'"
                }
            },
            {
                "action": "verify_other_lights_removed",
                "starting_state": "state_2",
                "ending_state": "state_3",
                "inputs": {
                    "assert_removed_lights": "for i in range(SHELLY_PLUS_RGBW_CHANNELS): assert get_entity(hass, LIGHT_DOMAIN, f'light:{i}') is None"
                }
            }
        ]
    },
