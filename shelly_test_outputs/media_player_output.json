        "name": "test_rpc_media_player_audio_file",
        "device_type": "media_player",
        "states": {
            "STATE_PLAYING": {
                "variables": {
                    "state.state": "STATE_PLAYING",
                    "ATTR_MEDIA_TITLE": "Title",
                    "ATTR_MEDIA_ARTIST": "Artist",
                    "ATTR_MEDIA_ALBUM_NAME": "Album Name",
                    "ATTR_MEDIA_DURATION": ".132",
                    "ATTR_MEDIA_POSITION": "64",
                    "ATTR_MEDIA_VOLUME_LEVEL": "0.2"
                }
            },
            "STATE_IDLE": {
                "variables": {
                    "state.state": "STATE_IDLE"
                }
            },
            "STATE_PLAYING_2": {
                "variables": {
                    "len(mock_rpc_device.media_play_or_pause.mock_calls)": "2",
                    "state.state": "STATE_PLAYING"
                }
            },
            "STATE_IDLE_2": {
                "variables": {
                    "state.state": "STATE_IDLE"
                }
            }
        },
        "transitions": [
            {
                "action": "init_integration",
                "starting_state": "initial_state",
                "ending_state": "STATE_PLAYING",
                "inputs": {
                    "hass": "hass",
                    "num_devices": 2,
                    "model": "MODEL_WALL_DISPLAY"
                }
            },
            {
                "action": "media_pause_service",
                "starting_state": "STATE_PLAYING",
                "ending_state": "STATE_IDLE",
                "inputs": {
                    "domain": "MEDIA_PLAYER_DOMAIN",
                    "service": "SERVICE_MEDIA_PAUSE",
                    "entity_id": "ENTITY_ID",
                    "blocking": true
                }
            },
            {
                "action": "media_play_service",
                "starting_state": "STATE_IDLE",
                "ending_state": "STATE_PLAYING_2",
                "inputs": {
                    "domain": "MEDIA_PLAYER_DOMAIN",
                    "service": "SERVICE_MEDIA_PLAY",
                    "entity_id": "ENTITY_ID",
                    "blocking": true
                }
            },
            {
                "action": "media_stop_service",
                "starting_state": "STATE_PLAYING_2",
                "ending_state": "STATE_IDLE_2",
                "inputs": {
                    "domain": "MEDIA_PLAYER_DOMAIN",
                    "service": "SERVICE_MEDIA_STOP",
                    "entity_id": "ENTITY_ID",
                    "blocking": true
                }
            }
        ]
    },
