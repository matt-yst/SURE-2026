    {
        "name": "test_sleeping_rpc_device_offline_during_setup",
        "device_type": "rpc_device",
        "states": {
            "initial_state": {
                "variables": {}
            },
            "offline_during_setup": {
                "variables": {
                    "'will resume when device is online'": "caplog.text",
                    "'is online (source: setup)'": "caplog.text",
                    "hass.states.get('sensor.test_name_temperature')": "None"
                }
            },
            "online_after_resume": {
                "variables": {}
            }
        },
        "transitions": [
            {
                "action": "set_attribute",
                "starting_state": "initial_state",
                "ending_state": "offline_during_setup",
                "inputs": {
                    "target": "mock_rpc_device.connected",
                    "value": false
                }
            },
            {
                "action": "set_item",
                "starting_state": "offline_during_setup",
                "ending_state": "offline_during_setup",
                "inputs": {
                    "dictionary": "mock_rpc_device.status['sys']",
                    "key": "wakeup_period",
                    "value": 1000
                }
            },
            {
                "action": "set_attribute",
                "starting_state": "offline_during_setup",
                "ending_state": "offline_during_setup",
                "inputs": {
                    "target": "mock_rpc_device.initialize",
                    "value": "AsyncMock(side_effect=DeviceConnectionError)"
                }
            },
            {
                "action": "init_integration",
                "starting_state": "offline_during_setup",
                "ending_state": "offline_during_setup",
                "inputs": {
                    "hass": "hass",
                    "param1": 2,
                    "sleep_period": 1000
                }
            },
            {
                "action": "async_block_till_done",
                "starting_state": "offline_during_setup",
                "ending_state": "offline_during_setup",
                "inputs": {
                    "wait_background_tasks": true
                }
            },
            {
                "action": "snapshot_assert",
                "starting_state": "initial_state",
                "ending_state": "offline_during_setup",
                "inputs": {
                    "snapshot": [
                        {
                            "'will resume when device is online'": "caplog.text"
                        },
                        {
                            "'is online (source: setup)'": "caplog.text"
                        },
                        {
                            "hass.states.get('sensor.test_name_temperature')": "None"
                        }
                    ]
                }
            },
            {
                "action": "set_attribute",
                "starting_state": "offline_during_setup",
                "ending_state": "offline_during_setup",
                "inputs": {
                    "target": "mock_rpc_device.initialize",
                    "value": "AsyncMock()"
                }
            },
            {
                "action": "mock_online",
                "starting_state": "offline_during_setup",
                "ending_state": "offline_during_setup",
                "inputs": {}
            },
            {
                "action": "async_block_till_done",
                "starting_state": "offline_during_setup",
                "ending_state": "offline_during_setup",
                "inputs": {
                    "wait_background_tasks": true
                }
            },
            {
                "action": "snapshot_assert",
                "starting_state": "offline_during_setup",
                "ending_state": "online_after_resume",
                "inputs": {
                    "snapshot": []
                }
            }
        ]
    },
    {
        "name": "test_entry_unload",
        "device_type": "cover",
        "states": {
            "loaded_state": {
                "variables": {
                    "entry.state": "ConfigEntryState.LOADED",
                    "state.state": "STATE_ON"
                }
            },
            "not_loaded_state": {
                "variables": {
                    "entry.state": "ConfigEntryState.NOT_LOADED",
                    "state.state": "STATE_UNAVAILABLE"
                }
            }
        },
        "transitions": [
            {
                "action": "init_integration",
                "starting_state": "initial_state",
                "ending_state": "loaded_state",
                "inputs": {
                    "hass": "hass",
                    "gen": "gen"
                }
            },
            {
                "action": "async_unload",
                "starting_state": "loaded_state",
                "ending_state": "not_loaded_state",
                "inputs": {
                    "entry_id": "entry.entry_id"
                }
            },
            {
                "action": "monkeypatch.delitem",
                "starting_state": "initial_state",
                "ending_state": "initial_state",
                "inputs": {
                    "target": "mock_rpc_device.status",
                    "key": "'cover:0'"
                }
            },
            {
                "action": "monkeypatch.setitem",
                "starting_state": "initial_state",
                "ending_state": "initial_state",
                "inputs": {
                    "target": "mock_rpc_device.status['sys']",
                    "key": "'relay_in_thermostat'",
                    "value": false
                }
            }
        ]
    },
