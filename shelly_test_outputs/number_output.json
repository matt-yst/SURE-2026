    {
        "name": "test_rpc_remove_virtual_number_when_mode_label",
        "device_type": "number",
        "states": {
            "snapshot_state": {
                "variables": {
                    "entity_registry.async_get(entity_id)": "None"
                }
            }
        },
        "transitions": [
            {
                "action": "setup_test_environment",
                "starting_state": "initial_state",
                "ending_state": "snapshot_state",
                "inputs": {
                    "config_copy": "config = deepcopy(mock_rpc_device.config)",
                    "add_virtual_number": "config['number:200'] = {'name': None, 'min': -1000, 'max': 1000, 'meta': {'ui': {'step': 1, 'unit': '', 'view': 'label'}}}",
                    "apply_config": "monkeypatch.setattr(mock_rpc_device, 'config', config)",
                    "status_copy": "status = deepcopy(mock_rpc_device.status)",
                    "set_virtual_number_value": "status['number:200'] = {'value': 123}",
                    "apply_status": "monkeypatch.setattr(mock_rpc_device, 'status', status)",
                    "init_integration": "config_entry = await init_integration(hass, 3, skip_setup=True)",
                    "register_device": "device_entry = register_device(device_registry, config_entry)",
                    "register_entity": "entity_id = register_entity(hass, NUMBER_DOMAIN, 'test_name_number_200', 'number:200-number_generic', config_entry, device_id=device_entry.id)",
                    "setup_entry": "await hass.config_entries.async_setup(config_entry.entry_id)",
                    "await_finish": "await hass.async_block_till_done()"
                }
            }
        ]
    },
