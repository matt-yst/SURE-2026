    {
        "name": "test_rpc_media_player_browse_media_radio_stations",
        "device_type": "media_player",
        "states": {
            "initial_state": {
                "variables": {}
            },
            "device_ready": {
                "variables": {}
            },
            "browse_media_response": {
                "variables": {
                    "msg['result']['title']": "'Radio stations'",
                    "msg['result']['media_class']": "'directory'",
                    "msg['result']['media_content_type']": "CONTENT_TYPE_RADIO",
                    "[child['title'] for child in msg['result']['children']]": "[station['name'] for station in RADIO_STATIONS]",
                    "[child['media_content_id'] for child in msg['result']['children']]": "[str(station['id']) for station in RADIO_STATIONS]",
                    "[child['thumbnail'] for child in msg['result']['children']]": "[station['icon'] for station in RADIO_STATIONS]"
                }
            }
        },
        "transitions": [
            {
                "action": "setup_device",
                "starting_state": "initial_state",
                "ending_state": "device_ready",
                "inputs": {
                    "status": "deepcopy(mock_rpc_device.status)",
                    "status['media']": "STATUS_RADIO_STATION",
                    "monkeypatch.setattr": "mock_rpc_device.status = status",
                    "mock_rpc_device.media_list_radio_stations.return_value": "RADIO_STATIONS",
                    "init_integration": {
                        "hass": "hass",
                        "device_count": 2,
                        "model": "MODEL_WALL_DISPLAY"
                    }
                }
            },
            {
                "action": "websocket_send",
                "starting_state": "device_ready",
                "ending_state": "browse_media_response",
                "inputs": {
                    "id": 1,
                    "type": "media_player/browse_media",
                    "entity_id": "ENTITY_ID",
                    "media_content_type": "CONTENT_TYPE_RADIO",
                    "media_content_id": "CONTENT_TYPE_RADIO"
                }
            }
        ]
    },
