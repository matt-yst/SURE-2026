[
    {
        "name": "test_rpc_media_player",
        "device_type": "media_player",
        "states": {
            "initial_state": {
                "variables": {
                    "state": "snapshot(name=f'{ENTITY_ID}-state', exclude=props('entity_picture_local'))",
                    "entry": "snapshot(name=f'{ENTITY_ID}-entry')"
                }
            },
            "buffering_state": {
                "variables": {
                    "state.state": "STATE_BUFFERING"
                }
            }
        },
        "transitions": [
            {
                "action": "init_integration",
                "starting_state": "null_state",
                "ending_state": "initial_state",
                "inputs": {
                    "hass": "hass",
                    "device_count": 2,
                    "model": "MODEL_WALL_DISPLAY"
                }
            },
            {
                "action": "mock_rpc_device.mock_update",
                "starting_state": "initial_state",
                "ending_state": "buffering_state",
                "inputs": {}
            }
        ]
    },
    {
        "name": "test_rpc_media_player_audio_file",
        "device_type": "media_player",
        "states": {
            "initial_state": {
                "variables": {}
            },
            "playing_initial": {
                "variables": {
                    "state.state": "STATE_PLAYING",
                    "state.attributes[ATTR_MEDIA_TITLE]": "Title",
                    "state.attributes[ATTR_MEDIA_ARTIST]": "Artist",
                    "state.attributes[ATTR_MEDIA_ALBUM_NAME]": "Album Name",
                    "state.attributes[ATTR_MEDIA_DURATION]": "132",
                    "state.attributes[ATTR_MEDIA_POSITION]": "64",
                    "state.attributes[ATTR_MEDIA_VOLUME_LEVEL]": "0.2"
                }
            },
            "idle_after_pause": {
                "variables": {
                    "state.state": "STATE_IDLE"
                }
            },
            "playing_after_play": {
                "variables": {
                    "len(mock_rpc_device.media_play_or_pause.mock_calls)": "2",
                    "state.state": "STATE_PLAYING"
                }
            },
            "idle_after_stop": {
                "variables": {
                    "state.state": "STATE_IDLE"
                }
            }
        },
        "transitions": [
            {
                "action": "init_integration",
                "starting_state": "initial_state",
                "ending_state": "playing_initial",
                "inputs": {
                    "hass": "hass",
                    "device_index": 2,
                    "model": "MODEL_WALL_DISPLAY"
                }
            },
            {
                "action": "MEDIA_PLAYER_DOMAIN.SERVICE_MEDIA_PAUSE",
                "starting_state": "playing_initial",
                "ending_state": "idle_after_pause",
                "inputs": {
                    "ATTR_ENTITY_ID": "ENTITY_ID"
                }
            },
            {
                "action": "MEDIA_PLAYER_DOMAIN.SERVICE_MEDIA_PLAY",
                "starting_state": "idle_after_pause",
                "ending_state": "playing_after_play",
                "inputs": {
                    "ATTR_ENTITY_ID": "ENTITY_ID"
                }
            },
            {
                "action": "MEDIA_PLAYER_DOMAIN.SERVICE_MEDIA_STOP",
                "starting_state": "playing_after_play",
                "ending_state": "idle_after_stop",
                "inputs": {
                    "ATTR_ENTITY_ID": "ENTITY_ID"
                }
            }
        ]
    },
    {
        "name": "test_rpc_media_player_actions",
        "device_type": "media_player",
