                    "blocking": true
                }
            },
            {
                "action": "play_media_service_call_audio",
                "starting_state": "volume_set",
                "ending_state": "play_audio",
                "inputs": {
                    "domain": "media_player",
                    "service": "play_media",
                    "service_data": {
                        "entity_id": "ENTITY_ID",
                        "media_content_type": "CONTENT_TYPE_AUDIO",
                        "media_content_id": "12"
                    },
                    "blocking": true
                }
            },
            {
                "action": "play_media_service_call_radio",
                "starting_state": "play_audio",
                "ending_state": "play_radio",
                "inputs": {
                    "domain": "media_player",
                    "service": "play_media",
                    "service_data": {
                        "entity_id": "ENTITY_ID",
                        "media_content_type": "CONTENT_TYPE_RADIO",
                        "media_content_id": "2"
                    },
                    "blocking": true
                }
            }
        ]
