        "transitions": [
            {
                "action": "init_integration",
                "starting_state": "initial_state",
                "ending_state": "state_1",
                "inputs": {
                    "hass": "hass",
                    "device_index": 2,
                    "sleep_period": 1000,
                    "model": "MODEL_PLUS_SMOKE"
                }
            },
            {
                "action": "mock_rpc_device.mock_online + hass.async_block_till_done",
                "starting_state": "state_1",
                "ending_state": "state_2",
                "inputs": {}
            },
            {
                "action": "mutate_rpc_device_status + mock_rpc_device.mock_update",
                "starting_state": "state_2",
                "ending_state": "state_3",
                "inputs": {
                    "device": "mock_rpc_device",
                    "entity": "smoke:0",
                    "attribute": "alarm",
                    "value": true
                }
            },
            {
                "action": "button_press_service_call + mock_rpc_device.mock_update + reset_initialized",
                "starting_state": "state_3",
                "ending_state": "state_4",
                "inputs": {
                    "domain": "BUTTON_DOMAIN",
                    "service": "SERVICE_PRESS",
                    "entity_id": "entity_id",
                    "blocking": true
                }
            }
        ]
