    {
        "name": "test_get_triggers_non_initialized_devices",
        "device_type": "block_device",
        "states": {
            "initial_state": {
                "variables": {}
            },
            "initialized_flag_set": {
                "variables": {
                    "mock_block_device.initialized": "False"
                }
            },
            "integration_initialized": {
                "variables": {
                    "entry": "Result of init_integration(hass, 1)"
                }
            },
            "device_fetched": {
                "variables": {
                    "device": "First device entry returned by dr.async_entries_for_config_entry"
                }
            },
            "expected_triggers_defined": {
                "variables": {
                    "expected_triggers": "[]"
                }
            },
            "triggers_obtained": {
                "variables": {
                    "triggers": "Result of async_get_device_automations(hass, DeviceAutomationType.TRIGGER, device.id) filtered by domain == DOMAIN"
                }
            },
            "final_state": {
                "variables": {
                    "triggers": "unordered(expected_triggers)"
                }
            }
        },
        "transitions": [
            {
                "action": "monkeypatch.setattr",
                "starting_state": "initial_state",
                "ending_state": "initialized_flag_set",
                "inputs": {
                    "target": "mock_block_device",
                    "attribute": "initialized",
                    "value": false
                }
            },
            {
                "action": "init_integration",
                "starting_state": "initialized_flag_set",
                "ending_state": "integration_initialized",
                "inputs": {
                    "hass": "hass",
                    "count": 1
                }
            },
            {
                "action": "dr.async_entries_for_config_entry",
                "starting_state": "integration_initialized",
                "ending_state": "device_fetched",
                "inputs": {
                    "device_registry": "device_registry",
                    "entry_id": "entry.entry_id"
                }
            },
            {
                "action": "assign",
                "starting_state": "device_fetched",
                "ending_state": "expected_triggers_defined",
                "inputs": {
                    "variable": "expected_triggers",
                    "value": "[]"
                }
            },
            {
                "action": "async_get_device_automations",
                "starting_state": "expected_triggers_defined",
                "ending_state": "triggers_obtained",
                "inputs": {
                    "hass": "hass",
                    "automation_type": "DeviceAutomationType.TRIGGER",
                    "device_id": "device.id"
                }
            },
            {
                "action": "filter_triggers_by_domain",
                "starting_state": "triggers_obtained",
                "ending_state": "final_state",
                "inputs": {
                    "domain": "DOMAIN"
                }
            }
        ]
    },
