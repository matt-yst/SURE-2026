    {
        "name": "test_is_block_momentary_input",
        "device_type": "multiple (MODEL_1L, MODEL_BUTTON1_V2)",
        "states": {
            "initial_state": {
                "variables": {}
            },
            "state1": {
                "variables": {
                    "is_block_momentary_input(mock_block_device.settings, mock_block_device.blocks[DEVICE_BLOCK_ID])": "False",
                    "is_block_momentary_input(mock_block_device.settings, mock_block_device.blocks[DEVICE_BLOCK_ID], True)": "True"
                }
            },
            "state2": {
                "variables": {
                    "is_block_momentary_input(mock_block_device.settings, mock_block_device.blocks[DEVICE_BLOCK_ID], True)": "False"
                }
            },
            "state3": {
                "variables": {
                    "is_block_momentary_input(mock_block_device.settings, mock_block_device.blocks[DEVICE_BLOCK_ID])": "False"
                }
            },
            "state4": {
                "variables": {
                    "is_block_momentary_input(mock_block_device.settings, mock_block_device.blocks[DEVICE_BLOCK_ID])": "True"
                }
            }
        },
        "transitions": [
            {
                "action": "initialise",
                "starting_state": "initial_state",
                "ending_state": "state1",
                "inputs": {
                    "setattr": {
                        "target": "mock_block_device.blocks[DEVICE_BLOCK_ID]",
                        "attribute": "type",
                        "value": "relay"
                    },
                    "setitem_mode": {
                        "target": "mock_block_device.settings",
                        "key": "mode",
                        "value": "roller"
                    },
                    "setitem_rollers": {
                        "target": "mock_block_device.settings",
                        "key": "rollers",
                        "value": [
                            {
                                "button_type": "detached"
                            }
                        ]
                    }
                }
            },
            {
                "action": "change_mode_and_device_type",
                "starting_state": "state1",
                "ending_state": "state2",
                "inputs": {
                    "setitem_mode_relay": {
                        "target": "mock_block_device.settings",
                        "key": "mode",
                        "value": "relay"
                    },
                    "setitem_device_type_MODEL_1L": {
                        "target": "mock_block_device.settings['device']",
                        "key": "type",
                        "value": "MODEL_1L"
                    }
                }
            },
            {
                "action": "remove_settings",
                "starting_state": "state2",
                "ending_state": "state3",
                "inputs": {
                    "delitem_inputs": {
                        "target": "mock_block_device.settings",
                        "key": "inputs"
                    },
                    "delitem_relays": {
                        "target": "mock_block_device.settings",
                        "key": "relays"
                    },
                    "delitem_rollers": {
                        "target": "mock_block_device.settings",
                        "key": "rollers"
                    }
                }
            },
            {
                "action": "set_device_type_button",
                "starting_state": "state3",
                "ending_state": "state4",
                "inputs": {
                    "setitem_device_type_MODEL_BUTTON1_V2": {
                        "target": "mock_block_device.settings['device']",
                        "key": "type",
                        "value": "MODEL_BUTTON1_V2"
                    }
                }
            }
        ]
    },
