        "name": "test_rpc_rgbw_device_rgb_w_modes_remove_others",
        "device_type": "Shelly RPC RGBW",
        "states": {
            "initial_state": {
                "variables": {}
            },
            "pre_setup_state": {
                "variables": {
                    "get_entity(hass, LIGHT_DOMAIN, removed_key)": "None"
                }
            },
            "post_setup_active_state": {
                "variables": {
                    "state.state": "STATE_ON",
                    "entry.unique_id": "f'123456789ABC-{active_mode}:0'"
                }
            },
            "final_state": {
                "variables": {
                    "get_entity(hass, LIGHT_DOMAIN, removed_key)": "None"
                }
            }
        },
        "transitions": [
            {
                "action": "initialize_and_remove_mode",
                "starting_state": "initial_state",
                "ending_state": "pre_setup_state",
                "inputs": {
                    "init_integration": {
                        "hass": "hass",
                        "device_count": 2,
                        "skip_setup": true
                    },
                    "register_device": {
                        "device_registry": "device_registry",
                        "config_entry": "config_entry"
                    },
                    "register_entity": [
                        {
                            "domain": "LIGHT_DOMAIN",
                            "entity_id_pattern": "light.test_name_test_light_{i}",
                            "unique_id_pattern": "light:{i}",
                            "config_entry": "config_entry",
                            "device_id": "device_entry.id"
                        }
                    ],
                    "remove_mode": {
                        "mock_rpc_device.status": "mock_rpc_device.status",
                        "key": "{removed_mode}:0"
                    },
                    "register_removed_entity": {
                        "domain": "LIGHT_DOMAIN",
                        "entity_id": "test_{removed_key}",
                        "unique_id": "removed_key",
                        "config_entry": "config_entry",
                        "device_id": "device_entry.id"
                    }
                }
            },
            {
                "action": "setup_config_entry",
                "starting_state": "pre_setup_state",
                "ending_state": "post_setup_active_state",
                "inputs": {
                    "async_setup": {
                        "entry_id": "config_entry.entry_id"
                    },
                    "async_block_till_done": {}
                }
            },
            {
                "action": "verify_removal",
                "starting_state": "post_setup_active_state",
                "ending_state": "final_state",
                "inputs": {
                    "assert_entities_not_present": {
                        "entity_pattern": "light:{i}",
                        "count": "SHELLY_PLUS_RGBW_CHANNELS"
                    },
                    "assert_removed_entity_not_present": {
                        "unique_id": "removed_key"
                    }
                }
            }
        ]
    },
