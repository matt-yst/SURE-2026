    {
        "name": "test_block_restored_climate_us_customary",
        "device_type": "climate",
        "states": {
            "initial_state": {
                "variables": {}
            },
            "state_0": {
                "variables": {
                    "state.state": "HVACMode.OFF",
                    "state.attributes.get(ATTR_TEMPERATURE)": "39",
                    "state.attributes.get(ATTR_CURRENT_TEMPERATURE)": "67"
                }
            },
            "state_1": {
                "variables": {
                    "state.state": "HVACMode.OFF",
                    "state.attributes.get(ATTR_TEMPERATURE)": "39",
                    "state.attributes.get(ATTR_CURRENT_TEMPERATURE)": "65"
                }
            },
            "state_2": {
                "variables": {
                    "state.state": "HVACMode.HEAT",
                    "state.attributes.get(ATTR_TEMPERATURE)": "50"
                }
            }
        },
        "transitions": [
            {
                "action": "init_integration_and_registration",
                "starting_state": "initial_state",
                "ending_state": "state_0",
                "inputs": {
                    "init_integration": {
                        "hass": "hass",
                        "device_count": 1,
                        "sleep_period": 1000,
                        "skip_setup": true
                    },
                    "register_device": {
                        "device_registry": "device_registry",
                        "entry": "entry"
                    },
                    "register_entity": {
                        "hass": "hass",
                        "domain": "CLIMATE_DOMAIN",
                        "name": "test_name",
                        "entity_id": "sensor_0",
                        "config_entry": "entry",
                        "device_id": "device.id"
                    },
                    "mock_restore_cache_with_extra_data": {
                        "entity_id": "entity_id",
                        "state": "HVACMode.OFF",
                        "attributes": {
                            "current_temperature": 67,
                            "temperature": 39
                        },
                        "extra_data": {
                            "last_target_temp": 10.0
                        }
                    },
                    "unit_system": "US_CUSTOMARY_SYSTEM"
                }
            },
            {
                "action": "mock_online_and_update_temperature",
                "starting_state": "state_0",
                "ending_state": "state_1",
                "inputs": {
                    "setattr_sensor_targetTemp": 4.0,
                    "setattr_sensor_temp": 18.2,
                    "mock_block_device.mock_online": null,
                    "await_hass_async_block_till_done": {
                        "wait_background_tasks": true
                    }
                }
            },
            {
                "action": "set_hvac_mode_to_heat",
                "starting_state": "state_1",
                "ending_state": "state_2",
                "inputs": {
                    "service_call": {
                        "domain": "CLIMATE_DOMAIN",
                        "service": "SERVICE_SET_HVAC_MODE",
                        "service_data": {
                            "ATTR_ENTITY_ID": "ENTITY_ID",
                            "ATTR_HVAC_MODE": "HVACMode.HEAT"
                        },
                        "blocking": true
                    },
                    "setattr_sensor_targetTemp": 10.0,
                    "mock_block_device.mock_update": null,
                    "assert_set_thermostat_state_called_once_with": [
                        0,
                        {
                            "target_t_enabled": 1,
                            "target_t": 10.0
                        }
                    ]
                }
            }
        ]
    },
    {
        "name": "test_block_restored_climate_unavailable",
        "device_type": "climate",
        "states": {
            "unavailable_restored_state": {
                "variables": {
                    "state.state": "HVACMode.OFF"
                }
            }
        },
        "transitions": [
            {
                "action": "setup_and_restore",
                "starting_state": "initial_state",
                "ending_state": "unavailable_restored_state",
                "inputs": {
                    "behaviour_steps": [
                        "monkeypatch.delattr(mock_block_device.blocks[DEVICE_BLOCK_ID], 'targetTemp')",
                        "monkeypatch.setattr(mock_block_device.blocks[DEVICE_BLOCK_ID], 'valveError', 0)",
                        "entry = await init_integration(hass, 1, sleep_period=1000, skip_setup=True)",
                        "device = register_device(device_registry, entry)",
                        "entity_id = register_entity(hass, CLIMATE_DOMAIN, 'test_name', 'sensor_0', entry, device_id=device.id)",
                        "mock_restore_cache(hass, [State(entity_id, STATE_UNAVAILABLE)])",
                        "monkeypatch.setattr(mock_block_device, 'initialized', False)",
                        "await hass.config_entries.async_setup(entry.entry_id)",
                        "await hass.async_block_till_done()"
                    ]
                }
            }
        ]
    },
