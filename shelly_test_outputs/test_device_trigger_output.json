[
    {
        "name": "test_get_triggers_block_device",
        "device_type": "block_device",
        "states": {
            "initial_state": {
                "variables": {}
            },
            "final_state": {
                "variables": {
                    "triggers": "unordered(expected_triggers)"
                }
            }
        },
        "transitions": [
            {
                "action": "run_test_steps",
                "starting_state": "initial_state",
                "ending_state": "final_state",
                "inputs": {
                    "step_1": "monkeypatch.setitem(mock_block_device.settings, 'relays', [{'btn_type': button_type}, {'btn_type': 'toggle'}])",
                    "step_2": "entry = await init_integration(hass, 1)",
                    "step_3": "device = dr.async_entries_for_config_entry(device_registry, entry.entry_id)[0]",
                    "step_4": "expected_triggers = []",
                    "step_5": "if is_valid:\n    expected_triggers = [{CONF_PLATFORM: 'device', CONF_DEVICE_ID: device.id, CONF_DOMAIN: DOMAIN, CONF_TYPE: type_, CONF_SUBTYPE: 'button1', 'metadata': {}} for type_ in ('single', 'long')]",
                    "step_6": "triggers = await async_get_device_automations(hass, DeviceAutomationType.TRIGGER, device.id)",
                    "step_7": "triggers = [value for value in triggers if value['domain'] == DOMAIN]"
                }
            }
        ]
    },
    {
        "name": "test_get_triggers_rpc_device",
        "device_type": "Shelly RPC device",
        "states": {
            "initial_state": {
                "variables": {}
            },
            "integration_initialized": {
                "variables": {}
            },
            "device_entry_obtained": {
                "variables": {
                    "device_id": "device.id"
                }
            },
            "expected_triggers_built": {
                "variables": {
                    "expected_triggers": "[{CONF_PLATFORM: 'device', CONF_DEVICE_ID: device.id, CONF_DOMAIN: DOMAIN, CONF_TYPE: trigger_type, CONF_SUBTYPE: 'button1', 'metadata': {}} for trigger_type in ('btn_down', 'btn_up', 'single_push', 'double_push', 'triple_push', 'long_push')]"
                }
            },
            "triggers_fetched": {
                "variables": {
                    "triggers_raw": "await async_get_device_automations(hass, DeviceAutomationType.TRIGGER, device.id)"
                }
            },
            "triggers_filtered": {
                "variables": {
                    "triggers": "[value for value in triggers_raw if value['domain'] == DOMAIN]"
                }
            },
            "asserted": {
                "variables": {
                    "triggers": "unordered(expected_triggers)"
                }
            }
        },
        "transitions": [
            {
                "action": "init_integration",
                "starting_state": "initial_state",
                "ending_state": "integration_initialized",
                "inputs": {
                    "hass": "hass",
                    "num_devices": 2
                }
            },
            {
                "action": "get_device_entry",
                "starting_state": "integration_initialized",
                "ending_state": "device_entry_obtained",
                "inputs": {
                    "device_registry": "device_registry",
                    "entry_id": "entry.entry_id"
                }
            },
            {
                "action": "build_expected_triggers",
                "starting_state": "device_entry_obtained",
                "ending_state": "expected_triggers_built",
                "inputs": {
                    "trigger_types": [
                        "btn_down",
                        "btn_up",
                        "single_push",
                        "double_push",
                        "triple_push",
                        "long_push"
                    ],
                    "subtype": "button1"
                }
            },
            {
                "action": "async_get_device_automations",
                "starting_state": "expected_triggers_built",
                "ending_state": "triggers_fetched",
                "inputs": {
                    "hass": "hass",
                    "automation_type": "DeviceAutomationType.TRIGGER",
                    "device_id": "device.id"
                }
            },
            {
                "action": "filter_triggers_by_domain",
                "starting_state": "triggers_fetched",
                "ending_state": "triggers_filtered",
                "inputs": {
                    "domain": "DOMAIN"
                }
            },
            {
                "action": "snapshot_assert",
                "starting_state": "triggers_filtered",
                "ending_state": "asserted",
                "inputs": {
                    "triggers": "unordered(expected_triggers)"
                }
            }
        ]
    },
    {
        "name": "test_get_triggers_button",
        "device_type": "button",
        "states": {
            "initial_state": {
                "variables": {}
            },
            "integration_initialized": {
                "variables": {
                    "entry": "result of init_integration(hass, 1, model=MODEL_BUTTON1)"
                }
            },
            "device_fetched": {
                "variables": {
                    "device": "result of dr.async_entries_for_config_entry(device_registry, entry.entry_id)[0]"
                }
            },
            "expected_computed": {
                "variables": {
                    "expected_triggers": "list comprehension over trigger_type in ('single','double','triple','long')"
                }
            },
            "triggers_retrieved": {
                "variables": {
                    "triggers": "result of async_get_device_automations(hass, DeviceAutomationType.TRIGGER, device.id)"
                }
            },
            "triggers_filtered": {
                "variables": {
                    "triggers": "filtered list where value['domain'] == DOMAIN"
                }
            },
            "snapshot": {
                "variables": {
                    "triggers": "unordered(expected_triggers)"
                }
            }
        },
        "transitions": [
            {
                "action": "init_integration",
                "starting_state": "initial_state",
                "ending_state": "integration_initialized",
                "inputs": {
                    "hass": "hass",
                    "num_devices": 1,
                    "model": "MODEL_BUTTON1"
                }
            },
            {
                "action": "async_entries_for_config_entry",
                "starting_state": "integration_initialized",
                "ending_state": "device_fetched",
                "inputs": {
                    "device_registry": "device_registry",
                    "entry_id": "entry.entry_id"
                }
            },
            {
                "action": "compute_expected_triggers",
                "starting_state": "device_fetched",
                "ending_state": "expected_computed",
                "inputs": {
                    "device_id": "device.id",
                    "domain": "DOMAIN",
                    "trigger_types": [
                        "single",
                        "double",
                        "triple",
                        "long"
                    ],
                    "subtype": "button"
                }
            },
            {
                "action": "async_get_device_automations",
                "starting_state": "expected_computed",
                "ending_state": "triggers_retrieved",
                "inputs": {
                    "hass": "hass",
                    "automation_type": "DeviceAutomationType.TRIGGER",
                    "device_id": "device.id"
                }
            },
            {
                "action": "filter_triggers_by_domain",
                "starting_state": "triggers_retrieved",
                "ending_state": "triggers_filtered",
                "inputs": {
                    "triggers": "triggers",
                    "domain": "DOMAIN"
                }
            },
            {
                "action": "assert_snapshot",
                "starting_state": "triggers_filtered",
                "ending_state": "snapshot",
                "inputs": {
                    "triggers": "unordered(expected_triggers)"
                }
            }
        ]
    },
    {
        "name": "test_get_triggers_non_initialized_devices",
        "device_type": "block_device",
        "states": {
            "initial_state": {
                "variables": {}
            },
            "integration_initialized": {
                "variables": {}
            },
            "device_not_initialized": {
                "variables": {}
            },
            "snapshot": {
                "variables": {
                    "triggers": "unordered([])",
                    ":comment": "The snapshot asserts that the list of triggers returned for a non\u2011initialized device is empty."
                }
            }
        },
        "transitions": [
            {
                "action": "init_integration",
                "starting_state": "initial_state",
                "ending_state": "integration_initialized",
                "inputs": {
                    "hass": "hass",
                    "device_count": 1,
                    "entry_var": "entry"
                }
            },
            {
                "action": "monkeypatch.setattr",
                "starting_state": "integration_initialized",
                "ending_state": "device_not_initialized",
                "inputs": {
                    "target": "mock_block_device",
                    "attribute": "initialized",
                    "value": false
                }
            },
            {
                "action": "async_get_device_automations",
                "starting_state": "device_not_initialized",
                "ending_state": "snapshot",
                "inputs": {
                    "hass": "hass",
                    "automation_type": "DeviceAutomationType.TRIGGER",
                    "device_id": "device.id",
                    "filter_domain": "DOMAIN"
                }
            }
        ]
    },
