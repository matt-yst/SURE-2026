    {
        "name": "test_rpc_water_valve",
        "device_type": "Water Valve",
        "states": {
            "closed_initial": {
                "variables": {
                    "entry.unique_id": "'123456789ABC-number:200-water_valve'",
                    "state.state": "ValveState.CLOSED"
                }
            },
            "open_after_open": {
                "variables": {
                    "state.state": "ValveState.OPEN"
                }
            },
            "closed_after_close": {
                "variables": {
                    "state.state": "ValveState.CLOSED"
                }
            },
            "open_position_50": {
                "variables": {
                    "state.state": "ValveState.OPEN",
                    "state.attributes.get(ATTR_CURRENT_POSITION)": "50"
                }
            }
        },
        "transitions": [
            {
                "action": "init_integration",
                "starting_state": "initial_state",
                "ending_state": "closed_initial",
                "inputs": {
                    "hass": "hass",
                    "param": 3,
                    "model": "MODEL_FRANKEVER_WATER_VALVE"
                }
            },
            {
                "action": "SERVICE_OPEN_VALVE",
                "starting_state": "closed_initial",
                "ending_state": "open_after_open",
                "inputs": {
                    "entity_id": "valve.test_name"
                }
            },
            {
                "action": "SERVICE_CLOSE_VALVE",
                "starting_state": "open_after_open",
                "ending_state": "closed_after_close",
                "inputs": {
                    "entity_id": "valve.test_name"
                }
            },
            {
                "action": "SERVICE_SET_VALVE_POSITION",
                "starting_state": "closed_after_close",
                "ending_state": "open_position_50",
                "inputs": {
                    "entity_id": "valve.test_name",
                    "position": 50
                }
            }
        ]
    },
