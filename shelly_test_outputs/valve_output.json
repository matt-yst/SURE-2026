[
    {
        "name": "test_block_device_gas_valve",
        "device_type": "gas_valve",
        "states": {
            "initial_state": {
                "variables": {}
            },
            "CLOSED_initial": {
                "variables": {
                    "entry.unique_id": "'123456789ABC-valve_0-valve'",
                    "entry.name": "None",
                    "entry.translation_key": "'gas_valve'",
                    "state.state": "ValveState.CLOSED"
                }
            },
            "OPENING": {
                "variables": {
                    "state.state": "ValveState.OPENING"
                }
            },
            "OPEN": {
                "variables": {
                    "state.state": "ValveState.OPEN"
                }
            },
            "CLOSING": {
                "variables": {
                    "state.state": "ValveState.CLOSING"
                }
            },
            "CLOSED_final": {
                "variables": {
                    "state.state": "ValveState.CLOSED"
                }
            }
        },
        "transitions": [
            {
                "action": "init_integration",
                "starting_state": "initial_state",
                "ending_state": "CLOSED_initial",
                "inputs": {
                    "hass": "hass",
                    "device_count": 1,
                    "model": "MODEL_GAS"
                }
            },
            {
                "action": "service_call",
                "starting_state": "CLOSED_initial",
                "ending_state": "OPENING",
                "inputs": {
                    "domain": "VALVE_DOMAIN",
                    "service": "SERVICE_OPEN_VALVE",
                    "service_data": {
                        "ATTR_ENTITY_ID": "entity_id"
                    }
                }
            },
            {
                "action": "mock_update (valve opened)",
                "starting_state": "OPENING",
                "ending_state": "OPEN",
                "inputs": {}
            },
            {
                "action": "service_call",
                "starting_state": "OPEN",
                "ending_state": "CLOSING",
                "inputs": {
                    "domain": "VALVE_DOMAIN",
                    "service": "SERVICE_CLOSE_VALVE",
                    "service_data": {
                        "ATTR_ENTITY_ID": "entity_id"
                    }
                }
            },
            {
                "action": "mock_update (valve closed)",
                "starting_state": "CLOSING",
                "ending_state": "CLOSED_final",
                "inputs": {}
            }
        ]
    },
    {
        "name": "test_rpc_water_valve",
        "device_type": "water valve",
        "states": {
            "state_1": {
                "variables": {
                    "entry.unique_id": "'123456789ABC-number:200-water_valve'",
                    "state.state": "ValveState.CLOSED"
                }
            },
            "state_2": {
                "variables": {
                    "state.state": "ValveState.OPEN"
                }
            },
            "state_3": {
                "variables": {
                    "state.state": "ValveState.CLOSED"
                }
            },
            "state_4": {
                "variables": {
                    "state.state": "ValveState.OPEN",
                    "state.attributes.get(ATTR_CURRENT_POSITION)": "50"
                }
            }
        },
        "transitions": [
            {
                "action": "SERVICE_OPEN_VALVE",
                "starting_state": "state_1",
                "ending_state": "state_2",
                "inputs": {
                    "entity_id": "valve.test_name"
                }
            },
            {
                "action": "SERVICE_CLOSE_VALVE",
                "starting_state": "state_2",
                "ending_state": "state_3",
                "inputs": {
                    "entity_id": "valve.test_name"
                }
            },
            {
                "action": "SERVICE_SET_VALVE_POSITION",
                "starting_state": "state_3",
                "ending_state": "state_4",
                "inputs": {
                    "entity_id": "valve.test_name",
                    "position": 50
                }
            }
        ]
    },
    {
        "name": "test_rpc_neo_water_valve",
        "device_type": "neo_water_valve",
        "states": {
            "state_1": {
                "variables": {
                    "entry.unique_id": "123456789ABC-boolean:200-neo_water_valve",
                    "state.state": "ValveState.CLOSED"
                }
            },
            "state_2": {
                "variables": {
                    "state.state": "ValveState.OPEN"
                }
            },
            "state_3": {
                "variables": {
                    "state.state": "ValveState.CLOSED"
                }
            }
        },
        "transitions": [
            {
                "action": "init_integration",
                "starting_state": "initial_state",
                "ending_state": "state_1",
                "inputs": {
                    "hass": "hass",
                    "device_index": 3,
                    "model": "MODEL_NEO_WATER_VALVE"
                }
            },
            {
                "action": "open_valve_service",
                "starting_state": "state_1",
                "ending_state": "state_2",
                "inputs": {
                    "domain": "VALVE_DOMAIN",
                    "service": "SERVICE_OPEN_VALVE",
                    "entity_id": "valve.test_name"
                }
            },
            {
                "action": "close_valve_service",
                "starting_state": "state_2",
                "ending_state": "state_3",
                "inputs": {
                    "domain": "VALVE_DOMAIN",
                    "service": "SERVICE_CLOSE_VALVE",
                    "entity_id": "valve.test_name"
                }
            }
        ]
    }
]