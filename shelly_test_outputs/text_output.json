[
    {
        "name": "test_rpc_device_virtual_text",
        "device_type": "text",
        "states": {
            "state_1": {
                "variables": {
                    "state.state": "lorem ipsum",
                    "entry.unique_id": "123456789ABC-text:203-text_generic"
                }
            },
            "state_2": {
                "variables": {
                    "state.state": "dolor sit amet"
                }
            },
            "state_3": {
                "variables": {
                    "state.state": "sed do eiusmod"
                }
            }
        },
        "transitions": [
            {
                "action": "init_integration",
                "starting_state": "initial_state",
                "ending_state": "state_1",
                "inputs": {
                    "hass": "hass",
                    "parameter": 3
                }
            },
            {
                "action": "mock_rpc_device.mock_update",
                "starting_state": "state_1",
                "ending_state": "state_2",
                "inputs": {
                    "status.text:203.value": "dolor sit amet"
                }
            },
            {
                "action": "hass.services.async_call",
                "starting_state": "state_2",
                "ending_state": "state_3",
                "inputs": {
                    "domain": "TEXT_DOMAIN",
                    "service": "SERVICE_SET_VALUE",
                    "data": {
                        "entity_id": "entity_id",
                        "value": "sed do eiusmod"
                    },
                    "blocking": true
                }
            }
        ]
    },
    {
        "name": "test_rpc_remove_virtual_text_when_mode_label",
        "device_type": "text",
        "states": {
            "snapshot_state": {
                "variables": {
                    "entity_registry.async_get(entity_id)": "None"
                }
            }
        },
        "transitions": [
            {
                "action": "setup_test_environment",
                "starting_state": "initial_state",
                "ending_state": "snapshot_state",
                "inputs": {
                    "config": "deepcopy(mock_rpc_device.config)",
                    "config_modification": "config['text:200'] = {'name': None, 'meta': {'ui': {'view': 'label'}}}",
                    "monkeypatch_config": "monkeypatch.setattr(mock_rpc_device, 'config', config)",
                    "status": "deepcopy(mock_rpc_device.status)",
                    "status_modification": "status['text:200'] = {'value': 'lorem ipsum'}",
                    "monkeypatch_status": "monkeypatch.setattr(mock_rpc_device, 'status', status)",
                    "init_integration": "config_entry = await init_integration(hass, 3, skip_setup=True)",
                    "register_device": "device_entry = register_device(device_registry, config_entry)",
                    "register_entity": "entity_id = register_entity(hass, TEXT_DOMAIN, 'test_name_text_200', 'text:200-text_generic', config_entry, device_id=device_entry.id)",
                    "setup_entry": "await hass.config_entries.async_setup(config_entry.entry_id)",
                    "block_till_done": "await hass.async_block_till_done()"
                }
            }
        ]
    },
    {
        "name": "test_rpc_remove_virtual_text_when_orphaned",
        "device_type": "text",
        "states": {
            "post_removal": {
                "variables": {
                    "entity_registry.async_get(entity_id)": "None"
                }
            }
        },
        "transitions": [
            {
                "action": "initialize_and_register_entities",
                "starting_state": "initial_state",
                "ending_state": "post_removal",
                "inputs": {
                    "init_integration": {
                        "hass": "hass",
                        "parameter": 3,
                        "skip_setup": true
                    },
                    "register_device": {
                        "device_registry": "device_registry",
                        "config_entry": "config_entry"
                    },
                    "register_entity": {
                        "hass": "hass",
                        "domain": "TEXT_DOMAIN",
                        "entity_name": "test_name_text_200",
                        "entity_type": "text:200-text_generic",
                        "config_entry": "config_entry",
                        "device_id": "device_entry.id"
                    },
                    "async_setup": {
                        "entry_id": "config_entry.entry_id"
                    },
                    "async_block_till_done": {}
                }
            }
        ]
    },
    {
