                "inputs": {
                    "init_integration": "await init_integration(hass, 1, sleep_period=1000, skip_setup=True)",
                    "register_device": "register_device(device_registry, entry)",
                    "register_entity": "register_entity(hass, BINARY_SENSOR_DOMAIN, 'test_name_motion', 'sensor_0-motion', entry, device_id=device.id)",
                    "mock_restore_cache": "mock_restore_cache(hass, [State(entity_id, STATE_ON)])",
                    "set_initialized_false": "monkeypatch.setattr(mock_block_device, 'initialized', False)",
                    "async_setup": "await hass.config_entries.async_setup(entry.entry_id)",
                    "block_till_done": "await hass.async_block_till_done()"
                }
            },
            {
                "action": "activate_device",
                "starting_state": "STATE_ON",
                "ending_state": "STATE_OFF",
                "inputs": {
                    "set_initialized_true": "monkeypatch.setattr(mock_block_device, 'initialized', True)",
                    "mock_online": "mock_block_device.mock_online()",
                    "block_till_done_background": "await hass.async_block_till_done(wait_background_tasks=True)"
                }
            }
        ]
