[
    {
        "name": "test_light_state_temperature",
        "device_type": "light",
        "states": {
            "snapshot": {
                "variables": {
                    "state": "snapshot",
                    "entry": "snapshot",
                    "device_entry": "snapshot"
                }
            }
        },
        "transitions": []
    },
    {
        "name": "test_light_change_state_temperature",
        "device_type": "Elgato Key Light",
        "states": {
            "state_0": {
                "variables": {
                    "state.state": "STATE_ON"
                }
            },
            "state_1": {
                "variables": {
                    "len(mock_elgato.light.mock_calls)": "1"
                }
            },
            "state_2": {
                "variables": {
                    "len(mock_elgato.light.mock_calls)": "2"
                }
            },
            "state_3": {
                "variables": {
                    "len(mock_elgato.light.mock_calls)": "3"
                }
            },
            "state_4": {
                "variables": {
                    "len(mock_elgato.light.mock_calls)": "4"
                }
            }
        },
        "transitions": [
            {
                "action": "turn_on",
                "starting_state": "state_0",
                "ending_state": "state_1",
                "inputs": {
                    "entity_id": "light.frenck",
                    "brightness": 255,
                    "color_temp_kelvin": 10000
                }
            },
            {
                "action": "turn_on",
                "starting_state": "state_1",
                "ending_state": "state_2",
                "inputs": {
                    "entity_id": "light.frenck",
                    "brightness": 255
                }
            },
            {
                "action": "turn_off",
                "starting_state": "state_2",
                "ending_state": "state_3",
                "inputs": {
                    "entity_id": "light.frenck"
                }
            },
            {
                "action": "turn_on",
                "starting_state": "state_3",
                "ending_state": "state_4",
                "inputs": {
                    "entity_id": "light.frenck",
                    "brightness": 255,
                    "hs_color": [
                        10.1,
                        20.2
                    ]
                }
            }
        ]
    },
    {
        "name": "test_light_unavailable",
        "device_type": "light",
        "states": {
            "unavailable_state": {
                "variables": {
                    "state.state": "STATE_UNAVAILABLE"
                }
            }
        },
        "transitions": [
            {
                "action": "hass.services.async_call",
                "starting_state": "initial_state",
                "ending_state": "unavailable_state",
                "inputs": {
                    "domain": "LIGHT_DOMAIN",
                    "service": "service",
                    "service_data": {
                        "ATTR_ENTITY_ID": "light.frenck"
                    },
                    "blocking": true,
                    "side_effects": {
                        "mock_elgato.light.side_effect": "ElgatoConnectionError"
                    },
                    "expected_exception": {
                        "type": "HomeAssistantError",
                        "match": "An error occurred while communicating with the Elgato device"
                    }
                }
            }
        ]
    },
    {
        "name": "test_light_identify",
        "device_type": "light",
        "states": {
            "initial_state": {
                "variables": {}
            },
            "state_success": {
                "variables": {
                    "len(mock_elgato.identify.mock_calls)": "1"
                }
            },
            "state_error": {
                "variables": {
                    "len(mock_elgato.identify.mock_calls)": "2"
                }
            }
        },
        "transitions": [
            {
                "action": "hass.services.async_call",
                "starting_state": "initial_state",
                "ending_state": "state_success",
                "inputs": {
                    "domain": "DOMAIN",
                    "service": "SERVICE_IDENTIFY",
                    "entity_id": "light.frenck",
                    "blocking": true
                }
            },
            {
                "action": "hass.services.async_call",
                "starting_state": "state_success",
                "ending_state": "state_error",
                "inputs": {
                    "domain": "DOMAIN",
                    "service": "SERVICE_IDENTIFY",
                    "entity_id": "light.frenck",
                    "blocking": true,
                    "expected_exception": {
                        "type": "HomeAssistantError",
                        "message": "An unknown error occurred while communicating with the Elgato device"
                    }
                }
            }
        ]
    }
]